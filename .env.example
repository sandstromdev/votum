# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# App origin, e.g. http://localhost:5173
ORIGIN=""

# Better Auth
# For production use 32 characters generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Sentry (optional). Leave empty to disable.
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# bun run setup:user (not required to start the app)
# SETUP_USER_EMAIL=""
# SETUP_USER_PASSWORD=""
# SETUP_USER_NAME=""

# bun run db:seed (optional demo Meeting for an existing Organizer)
# SEED_ORGANIZER_EMAIL=""
# SEED_ORGANIZER_USER_ID=""
