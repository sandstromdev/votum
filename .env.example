# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"
DATABASE_POOL_MAX="20"
# Optional structured server timings. Leave unset in normal operation.
# VOTUM_TIMINGS="1"
# Optional live-update debounce in milliseconds (default: 500; range: 0–60000).
# VOTUM_LIVE_UPDATE_DEBOUNCE_MS="500"

# App origin, e.g. http://localhost:5173
ORIGIN=""

# Better Auth
# For production use 32 characters generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# bun run setup:user (not required to start the app)
# SETUP_USER_EMAIL=""
# SETUP_USER_PASSWORD=""
# SETUP_USER_NAME=""

# bun run db:seed (optional demo Meeting for an existing Organizer)
# SEED_ORGANIZER_EMAIL=""
# SEED_ORGANIZER_USER_ID=""
